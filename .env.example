# Required
LINEAR_WEBHOOK_SECRET=       # Linear webhook signing secret
LINEAR_API_KEY=              # Linear API key (used by skills via curl)
GITHUB_TOKEN=                # GitHub PAT (used by skills via gh CLI)
AGENT_KEY=                   # Shared secret for worker callback authentication

# Optional — PM Agent
PORT=3000                    # Express port
MAX_TURNS=50                 # Max Claude turns for state machine skill

# Optional — Worker spawning (used by implement/revision skills)
WORKER_IMAGE=claude-worker:latest  # Docker image for workers
WORKER_NETWORK=pm-agent-net  # Docker network
WORKER_TIMEOUT=1800          # Worker timeout (seconds)
WORKER_MAX_TURNS=50          # Max Claude turns for workers
MAX_WIP=3                    # Max parallel worker containers
BASE_BRANCH=main             # Default base branch for workers
HOST_SSH_PATH=/root/.ssh     # Host path to SSH keys
HOST_CLAUDE_AUTH_PATH=claude-auth  # Named volume or host path for Claude OAuth credentials

# Optional — Workflow limits
MAX_REVIEW_CYCLES=3          # Max AI review iterations before escalating to human
REPO_LABEL_GROUP=Repo        # Linear label group name for repo mapping
