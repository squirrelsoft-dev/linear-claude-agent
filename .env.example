# Required
LINEAR_WEBHOOK_SECRET=       # Linear webhook signing secret
LINEAR_API_KEY=              # Linear API key
ANTHROPIC_API_KEY=           # Anthropic API key (for agent + workers)
REPO_URL=                    # Git SSH URL workers clone (e.g. git@github.com:org/repo.git)

# Optional
PORT=3000                    # Express port
WORKER_IMAGE=claude-worker:latest  # Docker image for workers
WORKER_NETWORK=pm-agent-net  # Docker network
WORKER_TIMEOUT=1800          # Worker timeout (seconds)
WORKER_MAX_TURNS=50          # Max Claude turns
CALLBACK_BASE_URL=http://pm-agent:3000  # How workers reach PM agent
HOST_SSH_PATH=/root/.ssh     # Host path to SSH keys
PM_AGENT_PROVIDER=anthropic  # LLM provider: anthropic | openai
PM_AGENT_MODEL=claude-sonnet-4-20250514  # Model name for the PM agent
PM_AGENT_API_KEY=            # Override default API key for PM agent (optional)
PM_AGENT_API_URL=            # Custom API base URL for PM agent (optional)
LOG_LEVEL=info               # pino log level (fatal|error|warn|info|debug|trace)
